---
import { site } from '../data/site';

interface Props {
  /** On the booking page the nav links should point back to the homepage anchors */
  home?: boolean;
}
const { home = true } = Astro.props;
const base = home ? '' : '/';

const links = [
  { label: 'About', href: `${base}#about` },
  { label: 'Services', href: `${base}#services` },
  { label: 'Media', href: `${base}#media` },
  { label: 'Featured', href: `${base}#featured` },
];
---

<header class="nav" data-nav>
  <div class="nav__inner wrap">
    <a class="nav__brand" href="/" aria-label={`${site.name} — home`}>
      <img src="/assets/logo-wordmark-white.png" alt={site.name} width="164" height="64" />
    </a>

    <nav class="nav__links" aria-label="Primary">
      {links.map((l) => <a href={l.href}>{l.label}</a>)}
    </nav>

    <div class="nav__cta">
      <a
        class="nav__ig"
        href={site.socials[0].url}
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Instagram"
      >
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <rect x="3" y="3" width="18" height="18" rx="5" stroke="currentColor" stroke-width="2" />
          <circle cx="12" cy="12" r="4" stroke="currentColor" stroke-width="2" />
          <circle cx="17.5" cy="6.5" r="1.5" fill="currentColor" />
        </svg>
      </a>
      <a class="btn" href="/booking">Book Overtime</a>
    </div>

    <button class="nav__toggle" data-nav-toggle aria-expanded="false" aria-controls="mobile-menu">
      <span class="sr-only">Menu</span>
      <span aria-hidden="true"></span><span aria-hidden="true"></span><span aria-hidden="true"></span>
    </button>
  </div>

  <div class="nav__mobile" id="mobile-menu" hidden>
    {links.map((l) => <a href={l.href} data-nav-close>{l.label}</a>)}
    <a href={site.socials[0].url} target="_blank" rel="noopener noreferrer" data-nav-close>Instagram</a>
    <a class="btn" href="/booking" data-nav-close>Book Overtime</a>
  </div>
</header>

<style>
  .nav {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 100;
    transition: background-color 0.3s ease, border-color 0.3s ease, backdrop-filter 0.3s ease;
    border-bottom: 1px solid transparent;
  }
  .nav[data-scrolled],
  .nav[data-open] {
    background: rgba(10, 10, 11, 0.95);
    border-bottom-color: var(--line);
  }
  .nav[data-open] { background: var(--ink); }
  .nav__inner {
    position: relative;
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    padding-block: 1.1rem;
  }
  .nav__brand { display: flex; }
  .nav__brand img { height: clamp(24px, 3.2vw, 32px); width: auto; }
  .nav__links { display: flex; gap: 2rem; }
  .nav__links a {
    font-family: var(--font-display);
    text-transform: uppercase;
    letter-spacing: 0.14em;
    font-size: 0.9rem;
    color: var(--mute);
    transition: color 0.15s ease;
  }
  .nav__links a:hover { color: var(--white); }
  .nav__cta { display: flex; align-items: center; gap: 1.1rem; }
  .nav__ig { color: var(--white); display: grid; place-items: center; transition: color 0.15s ease; }
  .nav__ig:hover { color: var(--orange); }
  .nav__cta .btn { padding: 0.7em 1.2em; font-size: 0.85rem; }

  .nav__toggle {
    display: none;
    flex-direction: column;
    gap: 5px;
    background: none;
    border: 0;
    cursor: pointer;
    padding: 8px;
  }
  .nav__toggle span:not(.sr-only) {
    width: 26px; height: 2px; background: var(--white); display: block;
    transition: transform 0.2s ease, opacity 0.2s ease;
  }
  .nav[data-open] .nav__toggle span:nth-child(2) { transform: translateY(7px) rotate(45deg); }
  .nav[data-open] .nav__toggle span:nth-child(3) { opacity: 0; }
  .nav[data-open] .nav__toggle span:nth-child(4) { transform: translateY(-7px) rotate(-45deg); }

  .nav__mobile {
    position: fixed;
    inset: 0;
    z-index: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 0.25rem;
    padding: 5rem var(--gutter) 3rem;
    background: var(--ink);
  }
  .nav__mobile a {
    font-family: var(--font-display);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    padding: 0.9rem 0;
    border-bottom: 1px solid var(--line);
  }
  .nav__mobile .btn { margin-top: 1rem; justify-content: center; }

  @media (max-width: 860px) {
    .nav__links, .nav__cta { display: none; }
    .nav__toggle { display: flex; }
  }
</style>

<script>
  import '../scripts/nav.js';
</script>
