---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/site';
---

<Base>
  <Nav />

  <main id="main">
    <!-- ============ HERO ============ -->
    <section class="hero">
      <div class="hero__media">
        <video
          class="hero__video"
          autoplay
          muted
          loop
          playsinline
          preload="metadata"
          poster="/assets/hero-poster.jpg"
        >
          <source src="/assets/hero.webm" type="video/webm" />
          <source src="/assets/hero.mp4" type="video/mp4" />
        </video>
        <img
          class="hero__fallback"
          src="/assets/hero.jpg"
          alt="THISISOVERTIME performing at Stadium Club, Caribe Royale Orlando"
          width="1920"
          height="1280"
          fetchpriority="high"
        />
        <div class="hero__scrim"></div>
      </div>

      <div class="wrap hero__content">
        <h1 class="sr-only">THISISOVERTIME — global DJ and producer, Resident DJ at Stadium Club Orlando</h1>
        <p class="eyebrow">Global DJ / Producer</p>
        <img
          class="hero__lockup"
          src="/assets/logo-wordmark-white.png"
          alt="THISISOVERTIME"
          width="1600"
          height="625"
          fetchpriority="high"
        />
        <p class="lead hero__line">{site.heroLine}</p>
        <div class="hero__actions">
          <a class="btn" href="/booking">Book for your event</a>
          <a class="btn btn--ghost" href="#media">Watch &amp; listen</a>
        </div>
        <p class="hero__meta">{site.categoryLine}</p>
      </div>
    </section>

    <!-- ============ PARTNER MARQUEE ============ -->
    <section class="marquee" aria-label="Featured on and trusted by">
      <div class="marquee__track">
        {[...site.partners, ...site.partners].map((p) => (
          <span class="marquee__item">{p}</span>
        ))}
      </div>
    </section>

    <!-- ============ ABOUT ============ -->
    <section class="section" id="about">
      <div class="wrap about">
        <div class="about__copy stack-lg">
          <p class="eyebrow">Profile</p>
          <h2 class="h-1">High-energy open-format DJ &amp; producer</h2>
          <hr class="neon-rule" />
          <p class="lead">
            THISISOVERTIME is known for commanding crowds and elevating live experiences
            across festivals, sports venues and premium events.
          </p>
          <p>
            As Resident DJ at <strong>Stadium Club (Caribe Royale Orlando)</strong>, he curates
            high-impact soundtracks for packed watch parties, brand activations and large-scale
            events. With a sharp sense of timing, crowd psychology and musical range, his
            performances are built for momentum, energy and unforgettable moments.
          </p>
          <ul class="about__genres">
            {site.genres.map((g) => <li>{g}</li>)}
          </ul>
        </div>
        <div class="gallery about__figure" role="region" aria-roledescription="carousel" aria-label="THISISOVERTIME photos" tabindex="0" data-carousel>
          <div class="gallery__track" data-carousel-track>
            {site.aboutGallery.map((img, i) => (
              <figure class="gallery__slide" id={`pg-${i}`}>
                <img
                  src={img.src}
                  alt={img.alt}
                  width="1000"
                  height="1250"
                  loading={i === 0 ? 'eager' : 'lazy'}
                  decoding="async"
                />
              </figure>
            ))}
          </div>
          {site.aboutGallery.length > 1 && (
            <>
              <a class="gallery__arrow gallery__arrow--prev" href={`#pg-${site.aboutGallery.length - 1}`} aria-label="Previous photo" data-carousel-prev>&lsaquo;</a>
              <a class="gallery__arrow gallery__arrow--next" href="#pg-1" aria-label="Next photo" data-carousel-next>&rsaquo;</a>
              <div class="gallery__dots">
                {site.aboutGallery.map((_, i) => (
                  <a href={`#pg-${i}`} aria-label={`Go to photo ${i + 1}`} data-carousel-dot aria-current={i === 0 ? 'true' : 'false'}><span></span></a>
                ))}
              </div>
            </>
          )}
        </div>
      </div>
    </section>

    <!-- ============ IMAGE BAND ============ -->
    <section class="band" aria-label="On the big stage">
      <img src="/assets/moment-trophy.jpg" alt="THISISOVERTIME at the Telemundo &amp; Peacock FIFA World Cup activation" width="1600" height="900" loading="lazy" />
      <div class="band__caption wrap">
        <p class="eyebrow">On the big stage</p>
        <p class="h-2">From watch parties to World&nbsp;Cup activations with Telemundo &amp; Peacock.</p>
      </div>
    </section>

    <!-- ============ SERVICES ============ -->
    <section class="section section--paper" id="services">
      <div class="wrap stack-lg">
        <div class="services__head">
          <p class="eyebrow">What he brings</p>
          <h2 class="h-1">Built for every room</h2>
        </div>
        <div class="services__grid">
          {site.services.map((s) => (
            <article class="service">
              <h3 class="h-3">{s.name}</h3>
              <p>{s.blurb}</p>
              <ul>
                {s.points.map((pt) => <li>{pt}</li>)}
              </ul>
              <div class="service__tags">
                {s.tags.map((t) => <span>{t}</span>)}
              </div>
            </article>
          ))}
        </div>
        <a class="btn btn--on-paper btn--ghost" href="/booking">Discuss your event</a>
      </div>
    </section>

    <!-- ============ MEDIA ============ -->
    <section class="section" id="media">
      <div class="wrap stack-lg">
        <div class="services__head">
          <p class="eyebrow">Media</p>
          <h2 class="h-1">See it. Hear it.</h2>
        </div>

        <div class="video-grid">
          {site.videos.map((v) => (
            <a
              class="video-card"
              href={
                v.kind === 'short'
                  ? `https://youtube.com/shorts/${v.id}`
                  : `https://youtu.be/${v.id}`
              }
              target="_blank"
              rel="noopener noreferrer"
            >
              <img
                src={`https://i.ytimg.com/vi/${v.id}/hqdefault.jpg`}
                alt={`THISISOVERTIME — ${v.title}`}
                width="480"
                height="360"
                loading="lazy"
              />
              <span class="video-card__play" aria-hidden="true">&#9658;</span>
              <span class="video-card__label">{v.title}</span>
            </a>
          ))}
        </div>

        <div class="mixes">
          <h3 class="h-3">Mixes</h3>
          <div class="mixes__list">
            {site.mixes.map((mix) => (
              <iframe
                class="mixes__player"
                title={`${mix.title} — DJ mix on hearthis.at`}
                src={`https://app.hearthis.at/embed/${mix.id}/transparent_black/?secret=${mix.secret}&hcolor=&color=&style=2&block_size=2&block_space=1&background=1&waveform=0&cover=0&autoplay=0&css=`}
                width="100%"
                height="150"
                loading="lazy"
                scrolling="no"
                frameborder="0"
                allowtransparency
                allow="autoplay"
              >
                <p>
                  Listen to <a href={mix.url} target="_blank" rel="noopener noreferrer">{mix.title}</a>
                  {' '}by <a href="https://hearthis.at/tiot/" target="_blank" rel="noopener noreferrer">TIOT</a>
                  {' '}on <a href="https://hearthis.at/" target="_blank" rel="noopener noreferrer">hearthis.at</a>
                </p>
              </iframe>
            ))}
          </div>
        </div>

        <div class="music">
          <h3 class="h-3">Releases</h3>
          <ul class="music__list">
            {site.music.map((m) => (
              <li>
                <a href={m.url} target="_blank" rel="noopener noreferrer">
                  <span class="music__title">{m.title}</span>
                  <span class="music__artist">{m.artists}</span>
                  <span class="music__cta">Stream &rarr;</span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </section>

    <!-- ============ FEATURED ============ -->
    <section class="section section--orange" id="featured">
      <div class="wrap stack-lg">
        <p class="eyebrow">Featured on &amp; trusted by</p>
        <h2 class="h-1">Proven on the biggest stages</h2>
        <p class="lead">
          THISISOVERTIME has been featured, trusted and partnered with leading venues, media
          platforms and brands across live entertainment, sports and hospitality.
        </p>
        <ul class="featured__list">
          {site.partners.map((p) => (
            <li>
              <img
                src={`/assets/partners/${p.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '')}.png`}
                alt={p}
                loading="lazy"
                decoding="async"
              />
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- ============ BOOKING CTA ============ -->
    <section class="section booking-cta">
      <div class="wrap stack-lg">
        <h2 class="h-1">Let&rsquo;s make it overtime.</h2>
        <p class="lead">
          Nightlife, festivals, watch parties, corporate and brand activations &mdash; based in
          {' '}{site.contact.baseLocation}, available worldwide.
        </p>
        <div class="hero__actions">
          <a class="btn" href="/booking">Start a booking</a>
          <a class="btn btn--ghost" href={`mailto:${site.contact.bookingEmail}`}>
            {site.contact.bookingEmail}
          </a>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Base>

<style>
  /* ---------- Hero ---------- */
  .hero { position: relative; min-height: 100svh; display: flex; align-items: flex-end; padding-block: 8rem 4rem; overflow: hidden; }
  .hero__media { position: absolute; inset: 0; z-index: -1; background: #000; }
  .hero__media img,
  .hero__media video {
    position: absolute; inset: 0; width: 100%; height: 100%;
    object-fit: cover; opacity: 0.55;
  }
  .hero__fallback { z-index: 0; }
  .hero__video { z-index: 1; }
  @media (prefers-reduced-motion: reduce) {
    .hero__video { display: none; }
  }
  .hero__scrim {
    position: absolute; inset: 0;
    background:
      radial-gradient(80% 60% at 15% 100%, rgba(242, 96, 31, 0.28), transparent 60%),
      radial-gradient(70% 60% at 90% 10%, rgba(255, 47, 176, 0.22), transparent 55%),
      linear-gradient(180deg, rgba(10,10,11,0.75), rgba(10,10,11,0.35) 40%, rgba(10,10,11,0.95));
  }
  .hero__content { position: relative; }
  .hero__content .eyebrow { letter-spacing: 0.32em; }
  .hero__lockup {
    width: min(680px, 82vw);
    height: auto;
    margin: 1.4rem 0 1.6rem -0.5%;
    filter: drop-shadow(0 0 45px rgba(242, 96, 31, 0.25));
  }
  .hero__line { max-width: 32ch; }
  .hero__actions { display: flex; flex-wrap: wrap; gap: 1rem; margin-top: 2rem; }
  .hero__meta {
    margin-top: 3rem; font-family: var(--font-display); text-transform: uppercase;
    letter-spacing: 0.25em; font-size: 0.8rem; color: var(--mute);
  }

  /* ---------- Marquee ---------- */
  .marquee { border-block: 1px solid var(--line); padding-block: 1.5rem; overflow: hidden; background: var(--ink-2); }
  .marquee__track {
    display: flex; gap: 3.5rem; width: max-content;
    animation: scroll 38s linear infinite;
  }
  .marquee__item {
    font-family: var(--font-display); text-transform: uppercase; letter-spacing: 0.16em;
    font-size: 1.1rem; color: var(--mute); white-space: nowrap;
  }
  @keyframes scroll { to { transform: translateX(-50%); } }
  @media (prefers-reduced-motion: reduce) {
    .marquee__track { animation: none; flex-wrap: wrap; width: auto; justify-content: center; }
  }

  /* ---------- About ---------- */
  .about { display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr); gap: clamp(2rem, 6vw, 5rem); align-items: start; }
  .about__genres { display: flex; flex-wrap: wrap; gap: 0.6rem; list-style: none; padding: 0; margin: 0; }
  .about__genres li {
    border: 1px solid var(--line); padding: 0.4rem 0.9rem; border-radius: 999px;
    font-family: var(--font-display); text-transform: uppercase; letter-spacing: 0.1em; font-size: 0.8rem;
  }
  .about__figure { margin: 0; }

  /* ---------- Profile carousel ---------- */
  .gallery { position: relative; min-width: 0; }
  .gallery:focus-visible { outline: 2px solid var(--orange); outline-offset: 4px; }
  .gallery__track {
    display: flex; min-width: 0; overflow-x: auto; scroll-snap-type: x mandatory;
    scroll-behavior: smooth; border-radius: var(--radius);
    scrollbar-width: none; -ms-overflow-style: none;
  }
  .gallery__track::-webkit-scrollbar { display: none; }
  .gallery__slide {
    position: relative; flex: 0 0 100%; min-width: 0; margin: 0; scroll-snap-align: start;
  }
  .gallery__slide img {
    display: block; width: 100%; aspect-ratio: 4 / 5; object-fit: cover;
    filter: grayscale(0.08) contrast(1.03);
  }
  .gallery__arrow {
    position: absolute; top: 50%; transform: translateY(-50%);
    display: grid; place-items: center; width: 2.75rem; height: 2.75rem;
    font-size: 1.6rem; line-height: 1; text-decoration: none;
    color: var(--white); background: rgba(10, 10, 11, 0.45);
    border: 1px solid rgba(255, 255, 255, 0.25); border-radius: 999px;
    backdrop-filter: blur(4px); transition: background 0.15s ease;
  }
  .gallery__arrow:hover { background: var(--orange); border-color: var(--orange); }
  .gallery__arrow--prev { left: 0.75rem; }
  .gallery__arrow--next { right: 0.75rem; }
  .gallery__dots {
    position: absolute; left: 0; right: 0; bottom: 0.9rem;
    display: flex; justify-content: center; gap: 0.5rem;
  }
  .gallery__dots a { display: block; padding: 0.35rem; }
  .gallery__dots span {
    display: block; width: 7px; height: 7px; border-radius: 999px;
    background: rgba(255, 255, 255, 0.5); box-shadow: 0 0 0 1px rgba(0, 0, 0, 0.3);
    transition: background 0.2s ease, transform 0.2s ease;
  }
  .gallery__dots a[aria-current='true'] span { background: var(--orange); transform: scale(1.35); }
  @media (hover: none) { .gallery__arrow { display: none; } }
  @media (prefers-reduced-motion: reduce) { .gallery__track { scroll-behavior: auto; } }

  @media (max-width: 860px) { .about { grid-template-columns: 1fr; } .about__figure { order: -1; } }

  /* ---------- Image band ---------- */
  .band { position: relative; min-height: 62svh; display: flex; align-items: flex-end; overflow: hidden; }
  .band > img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .band__caption {
    position: relative; width: 100%; padding-block: 2.5rem 3rem;
    background: linear-gradient(transparent, rgba(10, 10, 11, 0.9));
  }
  .band__caption .h-2 { max-width: 22ch; margin-top: 0.5rem; }

  /* ---------- Services ---------- */
  .services__head { max-width: 40ch; }
  .services__grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.5rem; }
  .service {
    background: var(--white); border: 1px solid rgba(0,0,0,0.08);
    padding: 1.75rem; border-radius: var(--radius); display: flex; flex-direction: column; gap: 1rem;
  }
  .service h3 { color: var(--paper-ink); }
  .service p { color: #55535a; font-size: 0.98rem; }
  .service ul { margin: 0; padding-left: 1.1rem; color: #55535a; font-size: 0.92rem; }
  .service ul li { margin-bottom: 0.35rem; }
  .service__tags { display: flex; flex-wrap: wrap; gap: 0.4rem; margin-top: auto; }
  .service__tags span {
    background: rgba(242, 96, 31, 0.1); color: var(--orange);
    font-size: 0.72rem; font-weight: 600; padding: 0.3rem 0.6rem; border-radius: 3px;
    text-transform: uppercase; letter-spacing: 0.05em;
  }
  @media (max-width: 860px) { .services__grid { grid-template-columns: 1fr; } }

  /* ---------- Media ---------- */
  .video-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1rem; }
  .video-card { position: relative; border-radius: var(--radius); overflow: hidden; border: 1px solid var(--line); }
  .video-card img { aspect-ratio: 16 / 10; object-fit: cover; width: 100%; transition: transform 0.35s ease; }
  .video-card:hover img { transform: scale(1.05); }
  .video-card__play {
    position: absolute; inset: 0; margin: auto; width: 54px; height: 54px;
    display: grid; place-items: center; background: rgba(242,96,31,0.92); color: #000;
    border-radius: 50%; font-size: 1.1rem; padding-left: 4px;
  }
  .video-card__label {
    position: absolute; left: 0; right: 0; bottom: 0; padding: 0.9rem 1rem 0.7rem;
    background: linear-gradient(transparent, rgba(0,0,0,0.85));
    font-family: var(--font-display); text-transform: uppercase; letter-spacing: 0.1em; font-size: 0.9rem;
  }
  @media (max-width: 860px) { .video-grid { grid-template-columns: repeat(2, 1fr); } }

  .mixes { margin-top: 3rem; }
  .mixes__list { display: grid; gap: 1rem; margin-top: 1rem; }
  .mixes__player {
    display: block; width: 100%; border: 1px solid var(--line);
    border-radius: var(--radius); background: var(--ink-2);
  }

  .music { margin-top: 3rem; }
  .music__list { list-style: none; padding: 0; margin: 1rem 0 0; border-top: 1px solid var(--line); }
  .music__list li { border-bottom: 1px solid var(--line); }
  .music__list a {
    display: grid; grid-template-columns: 1fr 1fr auto; align-items: baseline; gap: 1rem;
    padding: 1.15rem 0; transition: color 0.15s ease;
  }
  .music__title { font-family: var(--font-display); text-transform: uppercase; font-size: 1.3rem; letter-spacing: 0.04em; }
  .music__artist { color: var(--mute); font-size: 0.95rem; }
  .music__cta { color: var(--orange); font-weight: 600; }
  .music__list a:hover { color: var(--orange); }
  @media (max-width: 640px) {
    .music__list a { grid-template-columns: 1fr auto; }
    .music__artist { grid-column: 1 / -1; }
  }

  /* ---------- Featured ---------- */
  .featured__list {
    list-style: none; margin: 0; padding: 0;
    display: grid; grid-template-columns: repeat(4, 1fr);
    gap: 3.5rem 2rem; align-items: center;
  }
  .featured__list li { display: grid; place-items: center; }
  .featured__list img {
    max-height: 2.9rem; max-width: 82%; width: auto; height: auto;
    object-fit: contain;
  }
  @media (max-width: 860px) {
    .featured__list { grid-template-columns: repeat(2, 1fr); gap: 3rem 1.5rem; }
  }
  @media (max-width: 860px) { .featured__list { grid-template-columns: repeat(2, 1fr); } }

  /* ---------- Booking CTA ---------- */
  .booking-cta { text-align: center; background: radial-gradient(60% 100% at 50% 0%, rgba(242,96,31,0.12), transparent 70%); }
  .booking-cta .hero__actions { justify-content: center; }
  .booking-cta .lead { margin-inline: auto; max-width: 46ch; }
</style>

<script>
  import '../scripts/carousel.js';
</script>
